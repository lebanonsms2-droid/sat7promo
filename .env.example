# ---- Supabase (public, safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# ---- Supabase (server-only, NEVER expose to the browser) ----
# Used by trusted server-side operations only (server actions, admin tasks).
# Keep this secret in production (Vercel env vars / GitHub secrets).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key
