# ---- Supabase (public, safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Supabase (server-only, NEVER expose to the browser) ----
# Used by the seed script and by trusted server-side operations only.
# Keep this secret in production (Vercel env vars / GitHub secrets).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key